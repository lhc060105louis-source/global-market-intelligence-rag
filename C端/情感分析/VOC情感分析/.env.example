LLM_PROVIDER=remote
LLM_API_KEY=replace_with_your_api_key
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_TEXT_MODEL=doubao-seed-2-1-pro-260628
VOC_MAX_WORKERS=4

# Optional dynamic few-shot RAG. Generate rag_cases.jsonl before enabling.
VOC_RAG_ENABLED=false
RAG_CASE_STORE=rag_cases.jsonl
RAG_EMBEDDING_PROVIDER=sentence_transformers
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Initial values for MiniLM cosine similarity; calibrate against labeled data.
RAG_HIGH_THRESHOLD=0.75
RAG_MEDIUM_THRESHOLD=0.55
RAG_DIRECT_REAL_CASES=3
RAG_MAX_CASES_PER_TOPIC=100

# Optional backend push to Global RAG Hub after VOC analysis finishes.
C_RAG_PUSH_ENABLED=false
RAG_HUB_URL=http://127.0.0.1:8000
RAG_HUB_API_KEY=replace_with_rag_hub_api_key
C_RAG_PUSH_TIMEOUT_SECONDS=15
# 完成分析且业务日期早于当天的桶，同时写入 c_history；保留 current。可选 off / historical / always / explicit。
C_RAG_SNAPSHOT_MODE=historical
C_RAG_RECALL_THRESHOLD=1
C_RAG_LEGAL_THRESHOLD=1
C_RAG_RETRY_INTERVAL_SECONDS=60
C_RAG_RETRY_MAX_INTERVAL_SECONDS=900
C_RAG_RETRY_BATCH_SIZE=20

# Optional source collection. YouTube is the default overseas VOC source.
YOUTUBE_API_KEY=replace_with_your_youtube_data_api_key
# Optional proxy. Only set these if your network needs a local proxy for Google/YouTube APIs.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# Optional local Ollama mode:
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_TEXT_MODEL=qwen2.5:7b
