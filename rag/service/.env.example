RAG_HUB_DATABASE_URL=sqlite:///./data/rag_hub.db
RAG_HUB_API_KEY=replace-me
RAG_HUB_ACTOR_KEY_OPERATOR=
RAG_HUB_ACTOR_KEY_SYSTEM=
RAG_HUB_ACTOR_KEY_DOMAIN_SERVICE=
RAG_HUB_ACTOR_KEY_SCENARIO_ENGINE=
RAG_HUB_ACTOR_KEY_DEMO_DRIVER=
RAG_DEMO_MODE=off
RAG_HUB_ADAPTER=fake
RAG_HUB_FAKE_MODE=success

# KOL platform -> formal RAG Hub synchronization
RAG_HUB_BASE_URL=http://127.0.0.1:8001
KOL_SOURCE_BASE_URL=http://127.0.0.1:8766
KOL_SOURCE_TIMEOUT_SECONDS=15
# GET endpoints on the current local KOL platform do not require this token.
KOL_SOURCE_SESSION_TOKEN=
# Keep false for real assessments. Use --mock or true for demo spreadsheets.
KOL_SOURCE_IS_MOCK=false

# Original MaxKB integration (set RAG_HUB_ADAPTER=maxkb)
MAXKB_BASE_URL=http://127.0.0.1:8080
MAXKB_API_TOKEN=replace-me
MAXKB_WORKSPACE_ID=replace-me
MAXKB_KB_C_CURRENT=replace-me
MAXKB_KB_C_HISTORY=replace-me
MAXKB_KB_B_BUSINESS=replace-me
MAXKB_KB_KOL=replace-me
MAXKB_APP_C_CURRENT=
MAXKB_APP_C_HISTORY=
MAXKB_APP_B_BUSINESS=
MAXKB_APP_KOL=
MAXKB_APP_CROSS_DOMAIN=
MAXKB_APP_ACCESS_TOKEN_CROSS_DOMAIN=
MAXKB_QUERY_TOP_K=5
MAXKB_QUERY_SIMILARITY=0.6
MAXKB_QUERY_MAX_CONTEXT_CHARS=5000
RAG_QUERY_PLANNER_MODE=active
RAG_QUERY_MAX_RETRIES=1
RAG_QUERY_FALLBACK_TOP_K=15
RAG_QUERY_FALLBACK_SIMILARITY=0.35
RAG_QUERY_DEADLINE_SECONDS=60
RAG_SEMANTIC_DRAFT_MODE=active
RAG_HUB_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_HUB_OLLAMA_TEXT_MODEL=qwen2.5:7b
# One MaxKB semantic call may take longer for cross-domain questions on the
# local qwen model. The whole RAG query is still capped by RAG_QUERY_DEADLINE_SECONDS.
MAXKB_REQUEST_TIMEOUT_SECONDS=45
MAXKB_SYNC_POLL_INTERVAL_SECONDS=5
MAXKB_SYNC_MAX_ATTEMPTS=180

# The active RAG query budget is 60 seconds. The frontend same-origin proxy
# should leave network headroom; set this in the frontend process or here when
# the frontend reads this service env file.
RAG_FRONTEND_UPSTREAM_TIMEOUT_SECONDS=75
