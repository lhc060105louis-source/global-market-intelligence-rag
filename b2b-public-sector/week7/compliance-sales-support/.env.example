# Use PostgreSQL in production. If unset locally, the application falls back to compliance.db.
DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5432/compliance

# Replace with a strong random value. Never commit a real secret.
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Push events to the RAG Hub. When unconfigured or disabled, events remain in the outbox and do not block operations.
RAG_PUSH_ENABLED=false
RAG_HUB_BASE_URL=http://127.0.0.1:9000
RAG_HUB_API_KEY=
B_END_PUBLIC_URL=http://127.0.0.1:8000
