# 生产环境使用 PostgreSQL；本地未设置时兼容现有 compliance.db。
DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5432/compliance

# 必须替换为高强度随机值，不要提交真实密钥。
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# RAG Hub 主动通知。未配置或关闭时，事件保存在 Outbox，不影响业务保存。
RAG_PUSH_ENABLED=false
RAG_HUB_BASE_URL=http://127.0.0.1:9000
RAG_HUB_API_KEY=
B_END_PUBLIC_URL=http://127.0.0.1:8000
